{
  "schema": "scoped_authorization.consumer_migration.v2",
  "authority": "scoped_authorization",
  "rule": "Static confirmations and approval booleans are anti-mistake inputs, not user authorization. Every user turn or automation run derives one attenuated permit; environment changes may preserve equivalent authority or tighten, pause, and fence it, but never expand it automatically.",
  "connected": [
    {"consumer": "execution_route_pack", "actions": ["inspect_authorization_need", "project_environment_signature"], "status": "enforced", "permission_effect": "read_only_information_entry"},
    {"consumer": "codex_scheduler_runner", "actions": ["registered_task_run"], "status": "enforced", "permit_model": "registry_backed_system_default_per_automation_run"},
    {"consumer": "workflow_review_delivery", "actions": ["approve", "reject", "revise", "defer"], "status": "enforced", "effect_journal": true},
    {"consumer": "codex_environment_mirror", "actions": ["release", "resume_release_draft"], "status": "enforced", "effect_journal": true}
  ],
  "pending": [
    {"family": "package_and_plugin_install", "signals": ["install_approved", "INSTALL-*"]},
    {"family": "skill_rule_and_config_apply", "signals": ["apply_approved", "confirm-apply"]},
    {"family": "external_send_and_remote_write", "signals": ["remote_write_approved", "SEND", "publish"]},
    {"family": "device_windows_and_runtime_mutation", "signals": ["confirmation_required", "confirm"]},
    {"family": "mirror_refresh_publish_restore_stage", "signals": ["REFRESH-*", "PUBLISH-*", "STAGE-*"]}
  ],
  "dynamic_environment": {
    "authority": "scoped_authorization",
    "sources": ["workflow", "owner_capability", "system_membership", "rule_governance", "maintenance_capability", "state_write_authority", "dependency_intelligence", "runtime_health"],
    "automatic_outcomes": ["equivalent_reuse", "tighten", "pause", "fence"],
    "expansion_outcome": "authorization_reconciliation_required",
    "automatic_expansion_allowed": false
  },
  "completion_rule": "A pending family is complete only after every high-impact owner consumes turn/run permits, records effect readback, and negative regressions prove broad, stale, static, or environment-expanded authority cannot cause side effects."
}
