{
  "schema": "external_dependency_profile.v1",
  "schema_version": 1,
  "profile_id": "codex",
  "display_name": "OpenAI Codex",
  "owner": "dependency_change_intelligence.py",
  "trust_policy": {
    "runtime_handshake": 1,
    "bounded_differential_probe": 2,
    "official_document_or_release": 3,
    "official_repository_issue": 4,
    "signed_package_or_static_feature": 5
  },
  "configuration_boundaries": [
    "windows_local_host_profile",
    "remote_wsl_host_profile",
    "trusted_repository_dot_codex",
    "explicit_codex_home_profile"
  ],
  "fingerprint_components": [
    "desktop_package",
    "windows_cli",
    "wsl_cli_app_server"
  ],
  "source_tasks": [
    {
      "item_id": "official-codex-docs",
      "required": true,
      "acceptance": {
        "consumable_required": true,
        "provenance_required": true,
        "allowed_sources": ["openai-docs"],
        "maximum_age_hours": 72
      },
      "request": {
        "task": "Fetch current official Codex model, configuration, remote environment, and automation guidance",
        "target": "https://developers.openai.com/codex/models",
        "url": "https://developers.openai.com/codex/models",
        "intent": "documentation_lookup",
        "auto_owner": true,
        "timeout_seconds": 30,
        "metadata": {
          "preferred_owner_tools": ["openai-docs"],
          "validation_profile": "quick"
        }
      }
    },
    {
      "item_id": "official-codex-releases",
      "required": true,
      "acceptance": {
        "consumable_required": true,
        "provenance_required": true,
        "allowed_sources": ["github"],
        "minimum_candidates": 1,
        "maximum_age_hours": 168
      },
      "request": {
        "task": "Read bounded stable and prerelease tags and releases for openai/codex",
        "target": "https://github.com/openai/codex",
        "url": "https://github.com/openai/codex",
        "intent": "external_dependency",
        "auto_owner": true,
        "timeout_seconds": 35,
        "metadata": {
          "source_execution_contract": {
            "operations": ["release_read"],
            "selectors": {"repository": "openai/codex"},
            "limits": {"page_count": 1, "item_count": 12, "content_chars": 30000, "response_bytes": 262144},
            "acceptance": {"required_deliverables": ["releases"], "allow_partial": false}
          }
        }
      }
    },
    {
      "item_id": "official-codex-protocol-prs",
      "required": false,
      "acceptance": {
        "consumable_required": true,
        "provenance_required": true,
        "allowed_sources": ["github"],
        "maximum_age_hours": 168
      },
      "request": {
        "task": "Find merged protocol or config pull requests in openai/codex",
        "target": "https://github.com/openai/codex",
        "url": "https://github.com/openai/codex",
        "intent": "external_dependency",
        "auto_owner": true,
        "timeout_seconds": 35,
        "metadata": {
          "source_execution_contract": {
            "operations": ["pull_request_search"],
            "selectors": {"repository": "openai/codex", "issue_query": "is:merged (protocol OR config)"},
            "limits": {"page_count": 1, "item_count": 12, "content_chars": 24000, "response_bytes": 262144, "encoded_query_bytes": 512},
            "acceptance": {"required_deliverables": ["pull_requests"], "allow_partial": true}
          }
        }
      }
    },
    {
      "item_id": "official-codex-narrow-issues",
      "required": false,
      "acceptance": {
        "consumable_required": true,
        "provenance_required": true,
        "allowed_sources": ["github"],
        "maximum_age_hours": 168
      },
      "request": {
        "task": "Find narrow open issues for remote host settings, model reasoning, MCP, and thread branching",
        "target": "https://github.com/openai/codex",
        "url": "https://github.com/openai/codex",
        "intent": "external_dependency",
        "auto_owner": true,
        "timeout_seconds": 35,
        "metadata": {
          "source_execution_contract": {
            "operations": ["issue_search"],
            "selectors": {"repository": "openai/codex", "issue_query": "is:open (remote OR reasoning OR MCP OR branching)"},
            "limits": {"page_count": 1, "item_count": 12, "content_chars": 24000, "response_bytes": 262144, "encoded_query_bytes": 512},
            "acceptance": {"required_deliverables": ["issues"], "allow_partial": true}
          }
        }
      }
    }
  ],
  "capability_contracts": [
    {
      "capability_id": "desktop.host_settings_scope",
      "contract": "Windows All settings and remote project settings are separate host-scoped surfaces.",
      "hosts": ["windows_local", "remote_wsl"],
      "product_surfaces": ["desktop_all_settings", "remote_project_settings"],
      "authentication_boundary": "active_account_and_workspace_observed",
      "version_components": ["desktop_package", "wsl_cli_app_server", "official_sources"],
      "probes": [
        {"type": "fixture", "observed": "separate_host_scopes", "expected": "separate_host_scopes", "evidence_level": 2, "evidence_ref": "host_scope_contract_fixture"},
        {"type": "command", "command": ["{python}", "{bridge}/codex_config_guard.py", "snapshot"], "timeout_seconds": 20, "evidence_level": 2, "json_assertions": [{"path": "ok", "op": "equals", "value": true}]}
      ],
      "affected_owners": ["wsl_workspace_owner.py", "codex_config_guard.py"],
      "risk": "high",
      "planned_actions": [{"owner": "wsl_workspace_owner.py", "action": "host_scope_repair_plan", "state_changes": ["host_projection_if_approved"]}],
      "rollback_owner": "wsl_workspace_owner.py",
      "required_validation": ["host_scope_runtime_probe"]
    },
    {
      "capability_id": "desktop.capability_discovery",
      "contract": "Runtime capability discovery outranks renderer strings and static feature symbols.",
      "hosts": ["windows_local", "remote_wsl"],
      "product_surfaces": ["desktop", "app_server"],
      "version_components": ["desktop_package", "wsl_cli_app_server", "official_sources"],
      "probes": [{"type": "command", "command": ["{python}", "{bridge}/codex_desktop_model_runtime.py", "runtime", "--wait-seconds", "1", "--json"], "timeout_seconds": 15, "evidence_level": 1, "json_assertions": [{"path": "runtime.list_models_for_host_ok", "op": "equals", "value": true}]}],
      "affected_owners": ["codex_desktop_model_runtime.py"],
      "risk": "high",
      "planned_actions": [{"owner": "codex_desktop_model_runtime.py", "action": "runtime_capability_probe", "state_changes": []}],
      "rollback_owner": "codex_desktop_model_runtime.py",
      "required_validation": ["runtime_handshake_receipt"]
    },
    {
      "capability_id": "model.reasoning_efforts",
      "contract": "Reasoning efforts depend on model, product surface, client, and account rather than a fixed count.",
      "hosts": ["windows_local", "remote_wsl"],
      "product_surfaces": ["model_full_menu"],
      "version_components": ["desktop_package", "windows_cli", "wsl_cli_app_server", "official_sources"],
      "probes": [{"type": "command", "command": ["{python}", "{bridge}/codex_desktop_model_runtime.py", "runtime", "--wait-seconds", "1", "--json"], "timeout_seconds": 15, "evidence_level": 1, "json_assertions": [{"path": "runtime.enabled_reasoning_efforts", "op": "contains", "value": "ultra"}]}],
      "affected_owners": ["codex_desktop_model_runtime.py"],
      "risk": "high",
      "planned_actions": [{"owner": "codex_desktop_model_runtime.py", "action": "catalog_probe_only", "state_changes": []}],
      "rollback_owner": "codex_desktop_model_runtime.py",
      "required_validation": ["model_catalog_runtime_receipt"]
    },
    {
      "capability_id": "model.ultra_full_menu",
      "contract": "Ultra availability in the full model menu is independent from the shortcut slider toggle.",
      "hosts": ["windows_local", "remote_wsl"],
      "product_surfaces": ["model_full_menu"],
      "version_components": ["desktop_package", "wsl_cli_app_server", "official_sources"],
      "probes": [
        {"type": "fixture", "observed": "independent_surface", "expected": "independent_surface", "evidence_level": 2, "evidence_ref": "ultra_surface_contract_fixture"},
        {"type": "command", "command": ["{python}", "{bridge}/codex_desktop_model_runtime.py", "runtime", "--wait-seconds", "1", "--json"], "timeout_seconds": 15, "evidence_level": 1, "json_assertions": [{"path": "runtime.list_models_for_host_ok", "op": "equals", "value": true}, {"path": "runtime.enabled_reasoning_efforts", "op": "contains", "value": "ultra"}]}
      ],
      "affected_owners": ["codex_desktop_model_runtime.py"],
      "risk": "high",
      "planned_actions": [{"owner": "codex_desktop_model_runtime.py", "action": "full_menu_runtime_probe", "state_changes": []}],
      "rollback_owner": "codex_desktop_model_runtime.py",
      "required_validation": ["full_menu_runtime_receipt"]
    },
    {
      "capability_id": "model.ultra_shortcut_slider",
      "contract": "The optional Ultra shortcut slider setting is not proof of full-menu capability.",
      "hosts": ["windows_local", "remote_wsl"],
      "product_surfaces": ["model_shortcut_slider"],
      "version_components": ["desktop_package", "official_sources"],
      "probes": [{"type": "fixture", "observed": "optional_control_independent", "expected": "optional_control_independent", "evidence_level": 2, "evidence_ref": "ultra_slider_fixture"}],
      "affected_owners": ["codex_desktop_model_runtime.py"],
      "risk": "medium",
      "planned_actions": [{"owner": "codex_desktop_model_runtime.py", "action": "shortcut_slider_observation", "state_changes": []}],
      "rollback_owner": "codex_desktop_model_runtime.py",
      "required_validation": ["shortcut_slider_runtime_receipt"]
    },
    {
      "capability_id": "mcp.remote_host_authority",
      "contract": "Expected MCP bindings come from each active host authority, never a fixed numeric count.",
      "hosts": ["windows_local", "remote_wsl"],
      "product_surfaces": ["mcp_servers"],
      "version_components": ["desktop_package", "wsl_cli_app_server", "official_sources"],
      "probes": [{"type": "command", "command": ["{python}", "{bridge}/mcp_session_doctor.py", "snapshot"], "timeout_seconds": 25, "evidence_level": 1, "json_assertions": [{"path": "ok", "op": "equals", "value": true}, {"path": "config_path", "op": "not_empty"}]}],
      "affected_owners": ["mcp_session_doctor.py", "codex_config_guard.py"],
      "risk": "high",
      "planned_actions": [{"owner": "mcp_session_doctor.py", "action": "host_scoped_discovery", "state_changes": []}],
      "rollback_owner": "codex_config_guard.py",
      "required_validation": ["host_scoped_mcp_receipt"]
    },
    {
      "capability_id": "protocol.thread_branching",
      "contract": "Supported app-server branching methods are discovered by harmless handshake; deprecated rollback is never invoked.",
      "hosts": ["remote_wsl"],
      "product_surfaces": ["app_server_protocol"],
      "version_components": ["wsl_cli_app_server", "official_sources"],
      "probes": [{"type": "command", "command": ["{python}", "{bridge}/codex_desktop_protocol_compatibility.py", "inspect", "--timeout", "5"], "timeout_seconds": 10, "evidence_level": 5, "json_assertions": [{"path": "migration_complete", "op": "equals", "value": true}, {"path": "rollback_call_count", "op": "equals", "value": 0}]}],
      "affected_owners": ["wsl_workspace_owner.py"],
      "risk": "critical",
      "planned_actions": [{"owner": "wsl_workspace_owner.py", "action": "protocol_compatibility_plan", "state_changes": ["caller_migration_if_approved"]}],
      "rollback_owner": "wsl_workspace_owner.py",
      "required_validation": ["app_server_method_handshake"]
    },
    {
      "capability_id": "process.elevated_desktop_launch",
      "contract": "The governed elevated launcher starts Desktop without synchronous network or WSL waits.",
      "hosts": ["windows_local"],
      "product_surfaces": ["desktop_process"],
      "version_components": ["desktop_package"],
      "probes": [{"type": "fixture", "observed": "hidden_async_nonblocking", "expected": "hidden_async_nonblocking", "evidence_level": 2, "evidence_ref": "startup_chain_static_guard"}],
      "affected_owners": ["start-codex-desktop-elevated.ps1", "wsl_workspace_owner.py"],
      "risk": "critical",
      "planned_actions": [{"owner": "wsl_workspace_owner.py", "action": "launcher_repair_plan", "state_changes": ["host_projection_if_approved"]}],
      "rollback_owner": "wsl_workspace_owner.py",
      "required_validation": ["codex_startup_chain_tests.py"]
    },
    {
      "capability_id": "config.host_specific_resolution",
      "contract": "Personal, trusted-repository, explicit profile, Windows host, and remote WSL configuration retain distinct authority.",
      "hosts": ["windows_local", "remote_wsl"],
      "product_surfaces": ["config_resolution"],
      "version_components": ["desktop_package", "windows_cli", "wsl_cli_app_server", "official_sources"],
      "probes": [{"type": "command", "command": ["{python}", "{bridge}/codex_config_guard.py", "snapshot"], "timeout_seconds": 20, "evidence_level": 2, "json_assertions": [{"path": "ok", "op": "equals", "value": true}, {"path": "global_config.path", "op": "not_empty"}, {"path": "desktop_runtime_config.path", "op": "not_empty"}]}],
      "affected_owners": ["codex_config_guard.py", "wsl_workspace_owner.py"],
      "risk": "high",
      "planned_actions": [{"owner": "codex_config_guard.py", "action": "strict_config_resolution_probe", "state_changes": []}],
      "rollback_owner": "codex_config_guard.py",
      "required_validation": ["host_config_resolution_receipt"]
    }
  ]
}
