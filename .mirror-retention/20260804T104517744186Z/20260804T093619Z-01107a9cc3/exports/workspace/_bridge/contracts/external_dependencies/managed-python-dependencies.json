{
  "schema": "external_dependency_profile.v1",
  "schema_version": 1,
  "profile_id": "managed-python-dependencies",
  "display_name": "Resource managed Python dependencies",
  "owner": "dependency_change_intelligence.py",
  "trust_policy": {
    "runtime_handshake": 1,
    "bounded_differential_probe": 2,
    "official_document_or_release": 3,
    "official_repository_issue": 4,
    "signed_package_or_static_feature": 5
  },
  "configuration_boundaries": [
    "managed_dependency_lock",
    "python_abi_platform_target",
    "resource_package_owner"
  ],
  "fingerprint_components": [
    "official_package_metadata",
    "managed_dependency_lock",
    "runtime_import_acceptance"
  ],
  "source_tasks": [
    {
      "item_id": "official-beautifulsoup4-metadata",
      "required": true,
      "acceptance": {
        "consumable_required": true,
        "provenance_required": true,
        "allowed_sources": ["package_manager"],
        "maximum_age_hours": 168
      },
      "request": {
        "task": "Inspect current official BeautifulSoup package metadata against the managed dependency lock",
        "target": "beautifulsoup4",
        "intent": "package_dependency",
        "auto_owner": true,
        "timeout_seconds": 45,
        "metadata": {
          "package_ecosystem": "python",
          "package_action": "plan",
          "package_execution_mode": "inspect_then_install",
          "validation_profile": "full"
        }
      }
    }
  ],
  "capability_contracts": [
    {
      "capability_id": "resource.managed_python_dependency_lock",
      "contract": "Official package metadata is advisory evidence; the managed lock remains the sole executable version, artifact URL, and hash authority until an explicitly reviewed lock change is applied.",
      "hosts": ["remote_wsl", "windows_local"],
      "product_surfaces": ["resource_package_owner", "resource_html_parser"],
      "version_components": ["official_package_metadata", "managed_dependency_lock", "runtime_import_acceptance"],
      "probes": [
        {
          "type": "command",
          "command": ["{python}", "{bridge}/managed_python_dependency_runtime.py", "validate"],
          "timeout_seconds": 20,
          "evidence_level": 2,
          "json_assertions": [{"path": "ok", "op": "equals", "value": true}]
        }
      ],
      "affected_owners": ["resource_package_owner.py", "managed_python_dependency_runtime.py", "resource_python_package_installer.py"],
      "risk": "high",
      "planned_actions": [
        {
          "owner": "resource_package_owner.py",
          "action": "inspect_then_install_and_propose_lock_review",
          "state_changes": []
        }
      ],
      "rollback_owner": "resource_python_package_installer.py",
      "required_validation": ["metadata_lock_match", "hash_checking_mode", "fresh_process_import_origin"],
      "activation_acceptance": {
        "representative_tasks": [
          {
            "id": "inspect-managed-python-dependency",
            "message": "Inspect a managed Python dependency before deciding whether to install it",
            "expected_workflow_domain": "resource_acquisition",
            "expected_owner": "resource_package_owner"
          }
        ],
        "runtime_evidence": {
          "owner": "managed_python_dependency_runtime.py",
          "validation": "runtime-scoped fresh-process import probe"
        },
        "result_consumption": "The proposal consumes official metadata and the existing lock signature; it never auto-advances the lock or installs a package."
      }
    }
  ]
}
