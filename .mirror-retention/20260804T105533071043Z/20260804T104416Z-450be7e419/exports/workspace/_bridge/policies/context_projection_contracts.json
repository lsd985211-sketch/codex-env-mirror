{
  "schema": "context_projection_contracts.v1",
  "policy_version": "1",
  "default_inline_bytes": 8192,
  "reversible_compression_min_bytes": 16384,
  "reversible_compression_min_savings_ratio": 0.25,
  "contracts": {
    "default": {
      "required_fields": ["required_gates", "owner", "owner_status", "next_action", "safe_next_step", "manual_action", "error", "reason", "failure_reason", "stop_if"],
      "preserve_fields": ["schema", "ok", "status", "decision", "acceptance", "permission_boundary", "result_ref", "raw_result_ref"],
      "selectors": ["json_field", "object_id", "text_lines", "byte_range", "query_hit", "receipt_section"]
    },
    "test_result": {
      "required_fields": ["status", "failures", "error", "reason", "next_action"],
      "preserve_fields": ["schema", "ok", "summary", "failed_count", "passed_count", "validation_command"],
      "selectors": ["json_field", "object_id", "text_lines", "query_hit"]
    },
    "log": {
      "required_fields": ["status", "error", "reason", "failure_reason", "next_action"],
      "preserve_fields": ["schema", "ok", "terminal", "exit_code", "stderr_ref", "receipt_ref"],
      "selectors": ["text_lines", "byte_range", "query_hit"]
    },
    "resource": {
      "required_fields": ["status", "acceptance", "error_class", "reason", "next_action"],
      "preserve_fields": ["schema", "ok", "request_id", "result_kind", "provenance", "content_ref", "content_sha256"],
      "selectors": ["json_field", "object_id", "text_lines", "byte_range", "query_hit"]
    },
    "mcp_result": {
      "required_fields": ["error", "reason", "next_action"],
      "preserve_fields": ["schema", "ok", "profile", "tool", "route", "gateway_status", "owner_mcp_policy", "raw_result_ref"],
      "selectors": ["json_field", "object_id", "text_lines", "byte_range", "query_hit"]
    },
    "workflow": {
      "required_fields": ["required_gates", "stop_if", "owner", "acceptance", "safe_next_step", "manual_action"],
      "preserve_fields": ["schema", "ok", "status", "decision_evidence", "finalization", "record_path"],
      "selectors": ["json_field", "object_id", "receipt_section"]
    },
    "authorization": {
      "required_fields": ["scope", "operation_id", "grant_ref", "permit_ref", "consumption_ref", "status", "revocation"],
      "preserve_fields": ["schema", "ok", "generation", "authorization_turn_id", "effect_receipt_ref"],
      "selectors": ["json_field", "receipt_section"]
    }
  }
}
